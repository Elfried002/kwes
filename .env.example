# =============================================================================
# Kwes — .env.example
# Copier en .env puis renseigner. AUCUNE valeur secrète ne doit être commitée.
#   cp .env.example .env && chmod 600 .env
# Les valeurs vides sont volontaires : le backend échoue explicitement (ou passe
# en mode mock signalé `X-Kwes-Mock: 1`) plutôt que d'utiliser un défaut caché.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environnement
# -----------------------------------------------------------------------------
ENVIRONMENT=development           # development | test | production
LOG_LEVEL=info                    # debug | info | warning | error
LOG_FORMAT=text                   # text (dev) | json (prod)
KWES_VERSION=dev                  # tag d'image / version exposée par /health

# -----------------------------------------------------------------------------
# 2. Base de données (PostgreSQL 15+)
#    Dev local (docker compose --profile local) : service `postgres`
#    Prod Alpha : Supabase (Session pooler, port 5432, sslmode=require)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://kwes:kwes@127.0.0.1:5432/kwes
# Utilisée par les conteneurs (noms de services Docker, jamais 127.0.0.1)
CONTAINER_DATABASE_URL=postgresql+psycopg://kwes:kwes@postgres:5432/kwes
# Supabase — prod : postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_USER=kwes
POSTGRES_PASSWORD=kwes
POSTGRES_DB=kwes

# -----------------------------------------------------------------------------
# 3. Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CONTAINER_REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=2
WORKER_COMMAND=python -m app.worker

# -----------------------------------------------------------------------------
# 4. Authentification (JWT HS256)
#    Dev : DEV_JWT_SECRET. Prod : SUPABASE_JWT_SECRET (Project Settings > API).
# -----------------------------------------------------------------------------
DEV_JWT_SECRET=dev-secret-change-me
SUPABASE_JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated
ACCESS_TOKEN_TTL_MINUTES=60

# -----------------------------------------------------------------------------
# 5. Supabase (frontend / RLS)
#    L'anon key est publique par conception (protégée par la RLS).
#    La service_role key ne doit JAMAIS apparaître dans une variable VITE_*.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 6. Fournisseurs IA / voix — mocks si vides, signalés `X-Kwes-Mock: 1`
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_SECONDS=30

EMBEDDINGS_PROVIDER=openai       # openai | deepseek | mock
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# 7. CORS et URLs publiques
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_PUBLIC_URL=https://api.kwes.example

# -----------------------------------------------------------------------------
# 8. Frontend (build Vite) — JAMAIS de secret ici
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# 9. Reverse proxy / TLS
# -----------------------------------------------------------------------------
KWES_DOMAIN=localhost
LETSENCRYPT_EMAIL=
ACME_STAGING=1                    # 1 = Let's Encrypt staging (tests)

# -----------------------------------------------------------------------------
# 10. Politiques applicatives
# -----------------------------------------------------------------------------
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=120
MAX_UPLOAD_MB=25
TASK_MAX_DURATION_SECONDS=1800
TASK_MAX_STEPS=40
MEMORY_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
APPROVAL_TTL_MINUTES=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_TIMEOUT_SECONDS=180
EGRESS_ALLOWLIST=

# -----------------------------------------------------------------------------
# 11. Sauvegarde / observabilité
# -----------------------------------------------------------------------------
BACKUP_DIR=/var/backups/kwes
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_RECIPIENT=
SENTRY_DSN=
METRICS_ENABLED=false
HEARTBEAT_KEY=kwes:worker:heartbeat
