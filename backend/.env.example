# Kwes — variables d'environnement (exemple, AUCUNE valeur secrète)

# Base de données (PostgreSQL 15+ en prod, sqlite+aiosqlite en tests)
DATABASE_URL=
REDIS_URL=
# Rôle applicatif restreint (RLS active : ni superuser ni BYPASSRLS)
KWES_DB_APP_PASSWORD=

# Authentification (dev : DEV_JWT_SECRET ; prod : SUPABASE_JWT_SECRET + JWKS)
DEV_JWT_SECRET=
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Modèles (Gemini uniquement : voix, raisonnement, appels d'outils)
GOOGLE_API_KEY_ENC=
GOOGLE_LIVE_MODEL=gemini-3.8-live
GOOGLE_LIVE_THINKING_MODEL=gemini-3.8-live-extended-thinking
GEMINI_TEXT_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# API
CORS_ORIGINS=
APP_ENV=
LOG_LEVEL=
RATE_LIMIT_ENABLED=

# Skills / réseau (allowlist de domaines, configurée par environnement)
BROWSER_ALLOWLIST=
WEB_EXTRA_ALLOWLIST=
