# Kwes — variables d'environnement (exemple, AUCUNE valeur secrète)

# Base de données (PostgreSQL 15+ en prod, sqlite+aiosqlite en tests)
DATABASE_URL=
REDIS_URL=

# Authentification (dev : DEV_JWT_SECRET ; prod : SUPABASE_JWT_SECRET)
DEV_JWT_SECRET=
SUPABASE_JWT_SECRET=

# Fournisseurs (vides = mode MOCK explicite, en-tête X-Kwes-Mock: 1)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# API
CORS_ORIGINS=
APP_ENV=
LOG_LEVEL=
RATE_LIMIT_ENABLED=

# Skills / réseau (allowlist de domaines, configurée par environnement)
BROWSER_ALLOWLIST=
WEB_EXTRA_ALLOWLIST=
