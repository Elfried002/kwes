{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KWES Agent Result",
  "type": "object",
  "required": [
    "task_id",
    "mission_id",
    "agent_id",
    "status",
    "summary",
    "evidence",
    "limitations"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "data": {},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "description"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "storage_ref": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "filename",
          "mime_type",
          "storage_ref"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}