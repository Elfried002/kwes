# Backend Kwes — préfixe /api/v1 inclus
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Supabase Auth — valeurs publiques (URL du projet + clé anonyme).
# À copier depuis Supabase → Project Settings → API.
# Ne jamais placer ici la clé service_role : elle contourne les policies RLS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key-publique>
